<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ビルド: dotnet build -c Release -p:YMM4DirPath=C:\path\to\YukkuriMovieMaker_v4\
    （環境変数 YMM4DirPath でも可）。シェーダのコンパイルに Windows SDK の fxc.exe を使う。
    -p:DeployToYmm4=true を付けると、ビルド後に YMM4 の user\plugin へコピーする。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Controls"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.Controls.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="YukkuriMovieMaker.Plugin"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpGen.Runtime"><HintPath>$(YMM4DirPath)SharpGen.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpGen.Runtime.COM"><HintPath>$(YMM4DirPath)SharpGen.Runtime.COM.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.Direct2D1"><HintPath>$(YMM4DirPath)Vortice.Direct2D1.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.DirectX"><HintPath>$(YMM4DirPath)Vortice.DirectX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.Mathematics"><HintPath>$(YMM4DirPath)Vortice.Mathematics.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <SmootherShader Include="Shaders\Key.hlsl;Shaders\Edge.hlsl;Shaders\Weight.hlsl;Shaders\Blend.hlsl" />
    <None Include="Shaders\Common.hlsli" />
    <EmbeddedResource Include="@(SmootherShader->'$(IntermediateOutputPath)%(Filename).cso')">
      <LogicalName>OLMSmootherYMM4.%(Filename).cso</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CheckYmm4" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll')"
           Text="YMM4 が見つかりません。-p:YMM4DirPath=C:\path\to\YukkuriMovieMaker_v4\ （末尾の \ を忘れずに）を指定してください。" />
  </Target>

  <Target Name="CompileShaders" BeforeTargets="PrepareResources"
          Inputs="@(SmootherShader);Shaders\Common.hlsli"
          Outputs="@(SmootherShader->'$(IntermediateOutputPath)%(Filename).cso')">
    <!-- Windows SDK のバージョンは環境ごとに違うので、入っている中で一番新しい fxc.exe を使う -->
    <ItemGroup Condition="'$(FxcPath)' == ''">
      <FxcCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.*\x64\fxc.exe" />
    </ItemGroup>
    <PropertyGroup Condition="'$(FxcPath)' == '' And '@(FxcCandidate)' != ''">
      <FxcCandidates>@(FxcCandidate->'%(FullPath)')</FxcCandidates>
      <FxcPath>$(FxcCandidates.Substring($([MSBuild]::Add($(FxcCandidates.LastIndexOf(';')), 1))))</FxcPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(FxcPath)')" Text="fxc.exe が見つかりません。Windows SDK を入れるか、-p:FxcPath=... で指定してください。" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /WX /T ps_4_0 /E main /Fo &quot;$(IntermediateOutputPath)%(SmootherShader.Filename).cso&quot; &quot;%(SmootherShader.FullPath)&quot;" />
  </Target>

  <Target Name="DeployToYmm4" AfterTargets="Build" Condition="'$(DeployToYmm4)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(YMM4DirPath)user\plugin\$(ProjectName)" />
  </Target>
</Project>
